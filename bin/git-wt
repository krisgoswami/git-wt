#!/usr/bin/env bash
# Dispatcher, so `git wt <command>` works via git's built-in subcommand lookup:
# git finds any `git-<name>` executable on PATH.
#
# Note `git wt <substring>` cannot jump — a child process cannot change its
# parent shell's directory. Use the `wt` shell function for that, or
# `cd "$(git wt path <substring>)"`.
set -euo pipefail

_wt_self=$0
while [ -L "$_wt_self" ]; do
  _wt_link=$(readlink "$_wt_self")
  case "$_wt_link" in
    /*) _wt_self=$_wt_link ;;
    *)  _wt_self=$(dirname "$_wt_self")/$_wt_link ;;
  esac
done
WT_HOME=$(dirname "$(cd "$(dirname "$_wt_self")" && pwd -P)")
LIB="$WT_HOME/lib"

usage() {
  cat <<'HELP'
git wt ls                   list every worktree
git wt new <branch>         create and initialise a worktree (alias: create)
git wt clean [--whatif]     remove worktrees whose work has landed
git wt path <substring>     print the matching worktree's path
git wt root                 print the main checkout's path
git wt help                 this

Jumping needs the shell function — a child process cannot cd its parent.
Source wt.sh from your rc file, then use `wt <substring>`.
HELP
}

cmd=${1:-ls}
[ $# -gt 0 ] && shift

case "$cmd" in
  help | -h | --help)
    usage
    exit 0
    ;;
esac

. "$LIB/common.sh"
wt_require_repo

case "$cmd" in
  ls | list) git worktree list ;;
  new | create) "$LIB/make-worktree.sh" "$@" ;;
  clean) "$LIB/cleanup-worktrees.sh" "$@" ;;
  root) wt_main_repo ;;
  path)
    [ $# -gt 0 ] || { echo "git wt path <substring>" >&2; exit 1; }
    match=$(git worktree list --porcelain | awk '
      /^worktree /{ if (p != "") print p "\t" b; p = substr($0, 10); b = "(detached)" }
      /^branch /  { b = $2; sub("refs/heads/", "", b) }
      END         { if (p != "") print p "\t" b }' | grep -i -- "$1" | head -1 | cut -f1)
    [ -n "$match" ] || { echo "git wt: no worktree matching '$1'" >&2; exit 1; }
    printf '%s\n' "$match"
    ;;
  *)
    echo "git wt: unknown command '$cmd'" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
